# Database connection string (PostgreSQL with pgvector)
DATABASE_URL=postgresql://ilcms_user:ilcms_secret_password@postgres:5432/ilcms_db

# Air-Gapped Mode Flag
AIRGAP_MODE=true

# Ollama local inference service URL
OLLAMA_BASE_URL=http://ollama:11434

# Dedicated Icelandic Legal LLM (Ollama fine-tuned Gemma 2 or Miðeind Allra-Handa)
OLLAMA_MODEL=gemma2:9b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# On-Premises Keycloak OIDC Authentication
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ilcms
KEYCLOAK_CLIENT_ID=ilcms-web
